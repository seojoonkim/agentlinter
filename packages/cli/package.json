{
  "name": "agentlinter",
  "version": "2.3.0",
  "description": "ESLint for AI Agents — Score, diagnose, and auto-fix your CLAUDE.md and agent workspace files",
  "bin": {
    "agentlinter": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "agent",
    "lint",
    "claude",
    "agents-md",
    "claude-md"
  ],
  "author": "Seojoon Kim",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/engine/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
